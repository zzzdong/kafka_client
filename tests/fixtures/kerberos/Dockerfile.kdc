FROM debian:trixie-slim

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    krb5-kdc \
    krb5-admin-server \
    && rm -rf /var/lib/apt/lists/*

# 配置以模板形式打包, 由 init-kdc.sh 按 KRB5_REALM / KRB5_KDC_HOST 渲染,
# 使同一个镜像可服务于不同 realm 的多个 stack。
COPY kdc.conf.tmpl /etc/krb5kdc/kdc.conf.tmpl
COPY krb5.conf.tmpl /etc/krb5.conf.tmpl
COPY kadm5.acl.tmpl /etc/krb5kdc/kadm5.acl.tmpl
COPY init-kdc.sh /init-kdc.sh

RUN chmod +x /init-kdc.sh

EXPOSE 88/tcp 88/udp 749/tcp

ENTRYPOINT ["/init-kdc.sh"]
